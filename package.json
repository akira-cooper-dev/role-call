{
    "name": "role-call",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:backend": "npm run dev -w backend",
        "dev:extension": "npm run dev -w extension",
        "build:backend": "npm run build -w backend",
        "build:extension": "npm run build -w extension",
        "test": "npm run test --workspaces --if-present"
    }
}